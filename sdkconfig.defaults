# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.2 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_SYSMON=y
# S1.7:关闭 LVGL 屏上性能监视器——它在右下角周期刷新文本,自我维持刷新循环,
# 是空载持续重绘/交互卡顿的根因（需要性能数据时用 bsp_lcd 的串口 flush perf 统计）
# CONFIG_LV_USE_PERF_MONITOR is not set
CONFIG_LV_USE_DEMO_BENCHMARK=y
CONFIG_LV_USE_DEMO_STRESS=y
CONFIG_LV_USE_DEMO_MUSIC=y
CONFIG_LV_DEMO_MUSIC_AUTO_PLAY=y

# 主题过渡动画 80ms 保留（曾短暂关 0 修按键闪烁,后确认闪烁根因是双缓冲 sync 漏拷,单缓冲已根治,恢复柔和过渡,2026-11-20）
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=80

# WiFi+lwIP 可迁移分配进 PSRAM(2026-11-21:LVGL DMA 占内部 RAM 后 esp_wifi_init NO_MEM)
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# WiFi 缓冲裁剪(2026-11-21:LVGL DMA 占内部 RAM,静态 RX 10→4/动态 32→8/AMPDU 关——对时场景吞吐无关紧要)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
# WPA3 关(2026-11-21 省内部 RAM;热点用 WPA2)
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set

# 内部保留池 32K→16K + lwip 栈 3072→2048（2026-11-21:WiFi esf 池差 ~20KB,对时场景 DMA 突发需求小）
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=2048
CONFIG_LWIP_MAX_SOCKETS=4
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
